# Backend API base URL (must end with /api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Laravel public storage URL — must point to the /storage path on the backend server.
# On VPS set this to: https://api.yourdomain.com/storage
# Leave blank to auto-derive from NEXT_PUBLIC_API_URL (strips /api, appends /storage).
NEXT_PUBLIC_STORAGE_URL=http://localhost:8000/storage

# Optional integrations
NEXT_PUBLIC_HEALTHENGINE_URL=https://healthengine.com.au/book-appointment/your-practice-slug
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
